<?xml version="1.0" encoding="utf-8" ?>
<elements>
	<info>
        <name>Aurora Extra Options</name>
		<update version="0.0.4">
			<file name="AEO.xml" url="https://raw.githubusercontent.com/Xenirath/XENBuilder/main/XENBuilder/AEO.xml" />
		</update>
	</info>

	<!--Character Options-->

	<element name="Free Feat at level 1" type="Option" source="XENBuilder" id="ID_XENBUILDER_FREE_FEAT">
		<description>
			<p>Some DMs may grant a free feat for your characters at level 1. Check this if your DM does it.</p>
		</description>
		<setters>
			<set name="short">Free feat at level 1.</set>
		</setters>
		<rules>
			<select type="Feat" name="Free Feat (Level 1)" />
		</rules>
	</element> 

    <!--"Item"-like additions-->

	<element name="10 More Points (Eleazzar's Custom Race)" type="Item" source="XENBuilder" id="ID_XENBUILDER_ELEAZZAAR_MORE_POINTS_10">
		<description>
			<p><i>You can equip this item to “enable” it. It remains hidden from the inventory on your character sheet.</i></p>
			<p><i>Adds 10 points to your pool of Detect Balance's Custom Race, so you can play around more.</i></p>
		</description>
		<setters>
			<set name="category">Additional Custom Race Points</set>
			<set name="slot">misc</set>
			<set name="inventory-hidden">true</set>
		</setters>
		<rules>
			<stat name="eleazzaar points:points" value="-10" />
		</rules>
	</element> 

